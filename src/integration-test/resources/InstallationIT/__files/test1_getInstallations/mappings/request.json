{
	"request": {
		"method": "GET",
		"urlPath": "/api-datawarehousereader/2281/installations",
		"queryParameters": {
			"installed": {
				"equalTo": "true"
			},
			"lastModifiedDateFrom": {
				"equalTo": "2022-01-01"
			},
			"category": {
				"equalTo": "ELECTRICITY"
			},
			"facilityId": {
				"equalTo": "123456789132456780"
			},
			"sortBy": {
				"equalTo": "propertyName"
			},
			"sortDirection": {
				"equalTo": "ASC"
			},
			"page": {
				"equalTo": "1"
			},
			"limit": {
				"equalTo": "15"
			}
		}
	},
	"response": {
		"headers": {
			"Content-Type": "application/json"
		},
		"bodyFileName": "test1_getInstallations/responses/dwr-response.json",
		"status": 200
	}
}
